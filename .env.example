# =================================================================
# ECOROUTE ENVIRONMENT CONFIGURATION & API KEYS
# =================================================================

# 1. BASEMAP TILE SELECTION (Optional - Esri Dark Gray is enabled by default with NO key required)
# If using an Amazon Location Service API Key:
VITE_AWS_LOCATION_API_KEY=
VITE_AWS_REGION=us-east-1
VITE_AWS_MAP_NAME=EcoRouteMap

# If using a CARTO API Key (get free at https://carto.com/basemaps/apikey):
VITE_CARTO_API_KEY=

# 2. AMAZON COGNITO (For live AWS SDK SigV4 authenticated routing)
VITE_AWS_COGNITO_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_AWS_ROUTE_CALCULATOR_NAME=EcoRouteCalculator
VITE_AWS_PLACE_INDEX_NAME=EcoRoutePlaces

# 3. NREL ALTERNATIVE FUELING STATIONS (Get free at https://developer.nrel.gov/signup/)
VITE_NREL_API_KEY=DEMO_KEY

